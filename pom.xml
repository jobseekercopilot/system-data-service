<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.jobseekercopilot</groupId>
    <artifactId>system-data-service</artifactId>
    <version>1.0.0</version>
    <name>System Data Service</name>
    <description>Controlled deterministic fixtures and non-production state preparation</description>

    <properties>
        <java.version>17</java.version>
        <!-- Keep the complete Jackson line aligned while Boot 3.5.16 awaits
             its next maintenance release; see docs/DEPENDENCY_SECURITY.md. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <openapi-generator.version>7.22.0</openapi-generator.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-adzuna-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/contracts/adzuna-gateway-openapi.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/adzuna</output>
                            <apiPackage>com.jobseekercopilot.generated.adzunagateway.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.adzunagateway.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.adzunagateway.client</invokerPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-jsearch-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/contracts/jsearch-gateway-openapi.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/jsearch</output>
                            <apiPackage>com.jobseekercopilot.generated.jsearchgateway.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.jsearchgateway.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.jsearchgateway.client</invokerPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-reed-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/contracts/reed-gateway-openapi.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/reed</output>
                            <apiPackage>com.jobseekercopilot.generated.reedgateway.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.reedgateway.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.reedgateway.client</invokerPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-postcode-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/contracts/postcode-io-gateway-openapi.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/postcode</output>
                            <apiPackage>com.jobseekercopilot.generated.postcodeiogateway.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.postcodeiogateway.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.postcodeiogateway.client</invokerPackage>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <generatorName>java</generatorName>
                    <library>resttemplate</library>
                    <generateApiTests>false</generateApiTests>
                    <generateModelTests>false</generateModelTests>
                    <generateApiDocumentation>false</generateApiDocumentation>
                    <generateModelDocumentation>false</generateModelDocumentation>
                    <skipValidateSpec>false</skipValidateSpec>
                    <configOptions>
                        <annotationLibrary>none</annotationLibrary>
                        <dateLibrary>java8</dateLibrary>
                        <hideGenerationTimestamp>true</hideGenerationTimestamp>
                        <openApiNullable>false</openApiNullable>
                        <useJakartaEe>true</useJakartaEe>
                        <useRuntimeException>true</useRuntimeException>
                    </configOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
