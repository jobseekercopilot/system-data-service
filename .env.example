# Fixture and state-management APIs remain disabled unless explicitly enabled
# in a bounded local/test/demo environment. Do not put real credentials here.
SPRING_PROFILES_ACTIVE=local
SYSTEM_DATA_FIXTURES_ENABLED=false
SYSTEM_DATA_ENVIRONMENT_MANAGEMENT_ENABLED=false
# Set outside Git only when the API is deliberately enabled. Minimum 32 characters.
SYSTEM_DATA_INTERNAL_CALLER_KEY=
SYSTEM_DATA_REPOSITORY_DIRECTORY=./fixtures/datasets
