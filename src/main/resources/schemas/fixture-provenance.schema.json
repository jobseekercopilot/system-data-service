{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobseekercopilot.example.test/schemas/fixture-provenance-1.0.json",
  "title": "GovernedFixtureProvenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "classification",
    "purpose",
    "creation",
    "dataPolicy",
    "licence",
    "attribution",
    "approval",
    "lifecycle",
    "scenarioBundle",
    "payloadChecksums"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "datasetId": {"type": "string", "minLength": 1},
    "datasetVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "classification": {"const": "FULLY_SYNTHETIC"},
    "purpose": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "creation": {"type": "object", "required": ["method", "generator", "sourceSpecification", "sourceSpecificationSha256", "createdAt", "liveProvidersCalled"]},
    "dataPolicy": {"type": "object", "required": ["containsRealPersonalData", "containsCapturedProviderData", "containsProviderCredentials", "externalUrlsAllowed", "minimisation"]},
    "licence": {"type": "object", "required": ["identifier", "owner", "redistribution", "externalDatasets"]},
    "attribution": {"type": "array"},
    "approval": {"type": "object", "required": ["status", "approvedBy", "approvedAt", "scope"]},
    "lifecycle": {"type": "object", "required": ["reviewBy", "expiresAt", "refreshTrigger", "immutableVersion"]},
    "scenarioBundle": {"type": "object", "required": ["path", "files", "sha256"]},
    "payloadChecksums": {"type": "object", "required": ["jobs.json", "locations.json", "llm-fixtures.json"]}
  }
}
